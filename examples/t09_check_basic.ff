fn add(a: Int, b: Int) -> Int {
    return a + b;
}

fn mul(a: Int, b: Int) -> Int {
    return a * b;
}

fn compound() -> Int {
    return add(1, 2) + mul(3, 4);
}

fn main() {
    let x: Int = 5;
    let y: Int = 10;
    let z: Int = add(x, y);
    let w: Int = compound();
    let q: Bool = z > w;
    let r: Float = 1.5 * 2.0;
    let s: String = "hello" + " world";

    if (q) {
        let inner: Int = z + w;
    }

    while (x < y) {
        let step: Int = 1;
    }

    for (let i: Int = 0; i < 10; i += 1) {
        let item: Int = i;
    }

    return;
}