interface Animal {
    fn name() -> String;
    fn sound() -> String;
}

class Dog implements Animal {

    fn name() -> String { return  "Dog"; }
    fn sound() -> String { return "Woof!";}
}
class Cat implements Animal {
     fn name() -> String { return "Cat"; }
     fn sound() -> String { return "Meow!"; }

}

class Cow implements Animal {
    fn name() -> String { return "Cow"; }
    fn sound() -> String { return "Moo!"; }
}

fn announce(a: Animal) {
    println(a.name());
    println(a.sound());
    println("---");
}

fn main() {
    let d = new Dog();
    let c = new Cat();
    let m = new Cow();


    let animals: [Animal] = [ new Dog(), new Cat(), new Cow() ];
    var i: Int = 0;
    while (i < 3) {
        announce(animals[i]);
        i = i + 1;
    }

}