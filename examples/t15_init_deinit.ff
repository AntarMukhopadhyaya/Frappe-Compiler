class Allocator {
    fn init() { }
}

class Point {
    x: Float;
    y: Float;

    fn init(alloc: Allocator, x: Float, y: Float) {
        this.x = x;
        this.y = y;
    }

    fn deinit() { }
}

class BadInitReturn {
    fn init(alloc: Allocator, x: Float) -> Int { return 0; }
}

class BadInitStatic {
    static fn init(alloc: Allocator, x: Float) { }
}



class BadDeinitReturn {
    fn deinit() -> Int { return 0; }
}

fn main() {
    let alloc = new Allocator();
    let p = new Point(alloc, 1.0, 2.0);
    p.deinit(alloc);
    return;
}